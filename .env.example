# Valores locais de desenvolvimento. Copie para .env e ajuste se precisar;
# os padrões em docker-compose.yaml já funcionam sem este arquivo.
POSTGRES_PASSWORD=directus-dev-only
PGADMIN_DEFAULT_EMAIL=dev@localhost
PGADMIN_DEFAULT_PASSWORD=directus-dev-only
DB_PASSWORD=directus-dev-only
ADMIN_PASSWORD=directus-dev-only
DIRECTUS_KEY=directus-dev-key-not-a-secret
DIRECTUS_SECRET=directus-dev-secret-not-a-secret-0123456789

# Portas e versão — os padrões de docker-compose.yaml valem sem estas variáveis.
DATABASE_PORT=5432
PGADMIN_PORT=16543
DIRECTUS_PORT=8055
DIRECTUS_VERSION=11.5.1
PUBLIC_URL=http://localhost:8055