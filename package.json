{
  "name": "@devix-tecnologia/directus-extension-mapgrid",
  "version": "1.5.1",
  "description": "Extension for show map and grid list on Layout Directus",
  "icon": "extension",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-layout",
    "map",
    "grid"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Devix Tecnologia",
  "contributors": [
    {
      "name": "Fernando Gatti",
      "github": "https://github.com/gattifernando",
      "linkedin": "https://www.linkedin.com/in/gattifernando/"
    },
    {
      "name": "Sidarta Veloso",
      "github": "https://github.com/sidartaveloso",
      "linkedin": "https://www.linkedin.com/in/sidartaveloso"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/devix-tecnologia/directus-extension-mapgrid"
  },
  "engines": {
    "node": ">=22.13.1",
    "pnpm": ">=10.15.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist/",
    "package.json",
    "pnpm-lock.yaml"
  ],
  "directus:extension": {
    "type": "layout",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^11.0.0",
    "sandbox": {
      "enabled": true,
      "requestedScopes": {}
    },
    "types": [
      "layout"
    ]
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "validate": "directus-extension validate",
    "link": "directus-extension link",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" --fix",
    "format": "prettier --write src/",
    "prepare": "husky"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "^16.0.2",
    "@directus/types": "^13.2.3",
    "@eslint/js": "^9.36.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.5.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "prettier": "^3.6.2",
    "semantic-release": "^24.2.9",
    "storytype": "^0.2.6",
    "taskin": "^3.0.3",
    "typescript": "^5.9.3",
    "vue": "^3.5.22",
    "vue-eslint-parser": "^10.2.0"
  },
  "dependencies": {
    "@types/geojson": "^7946.0.16",
    "maplibre-gl": "^5.8.0"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 100,
    "semi": true,
    "tabWidth": 2
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github",
      "@semantic-release/git"
    ]
  }
}
