{
  "name": "@devix-tecnologia/directus-extension-mapgrid",
  "version": "1.5.1",
  "description": "Extension for show map and grid list on Layout Directus",
  "icon": "extension",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-layout",
    "map",
    "grid"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Devix Tecnologia",
  "contributors": [
    {
      "name": "Fernando Gatti",
      "github": "https://github.com/gattifernando",
      "linkedin": "https://www.linkedin.com/in/gattifernando/"
    },
    {
      "name": "Sidarta Veloso",
      "github": "https://github.com/sidartaveloso",
      "linkedin": "https://www.linkedin.com/in/sidartaveloso"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/devix-tecnologia/directus-extension-mapgrid"
  },
  "engines": {
    "node": ">=22.13.1",
    "pnpm": ">=10.15.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist/",
    "package.json",
    "pnpm-lock.yaml"
  ],
  "directus:extension": {
    "type": "layout",
    "path": "dist/index.js",
    "source": "src/index.ts",
    "host": "^11.0.0",
    "sandbox": {
      "enabled": true,
      "requestedScopes": {}
    },
    "types": [
      "layout"
    ]
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "validate": "directus-extension validate",
    "link": "directus-extension link",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "lint": "biome check",
    "lint:fix": "biome check --write --unsafe",
    "format": "biome format --write src/",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "VERBOSE=true node tests/run-docker-tests.js integration",
    "test:e2e": "VERBOSE=true node tests/run-docker-tests.js e2e",
    "test:e2e:ui": "VERBOSE=true node tests/run-docker-tests.js e2e -- --ui",
    "test:e2e:record": "VERBOSE=true node tests/run-docker-tests.js e2e -- --config=playwright.record.config.ts",
    "test:e2e:record:head": "VERBOSE=true node tests/run-docker-tests.js e2e -- --config=playwright.record.config.ts && pnpm exec playwright show-report playwright-report",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:all": "pnpm test && pnpm test:integration && pnpm test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@directus/extensions-sdk": "^16.0.2",
    "@directus/types": "^13.2.3",
    "@playwright/test": "^1.62.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/vue3-vite": "^10.5.10",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.4.11",
    "axios": "^1.19.0",
    "globals": "^16.4.0",
    "happy-dom": "^20.11.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "playwright": "^1.62.1",
    "semantic-release": "^24.2.9",
    "storybook": "^10.5.10",
    "storytype": "^0.2.6",
    "taskin": "^3.0.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "vue": "^3.5.22",
    "vue-router": "4.5.1",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@types/geojson": "^7946.0.16",
    "maplibre-gl": "^5.8.0"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "biome check --write"
    ]
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github",
      "@semantic-release/git"
    ]
  }
}
